<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@color/transparent"
            android:drawableLeft="@drawable/arrow_back_ios_24px"
            android:gravity="center"
            android:fontFamily="@font/bebas"
            android:text="ANIME DETAILS"
            android:textAlignment="center"
            android:textColor="@color/pinkRed"
            android:textSize="20sp"/>

        <!-- Anime information container -->
        <LinearLayout
            android:id="@+id/anime_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="8dp"
                    android:layout_margin="10dp"
                    android:elevation="10dp">
                    <!-- Anime image -->
                    <ImageView
                        android:id="@+id/anime_image"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#80000000" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="8dp"
                    android:layout_margin="10dp"
                    android:elevation="10dp">
                    <ImageView
                        android:id="@+id/ivImage"
                        android:layout_width="150dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="bottom"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="8dp"
                android:layout_margin="10dp"
                android:elevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <Button
                        android:id="@+id/play_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableLeft="@drawable/play_arrow_24px"
                        android:text="Play"
                        android:backgroundTint="@color/limegreen"
                        app:cardCornerRadius="8dp"
                        android:paddingHorizontal="110dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:textSize="15dp"
                        android:fontFamily="@font/oswald" />

                    <ToggleButton
                        android:id="@+id/add_to_favorites_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/favorite_icon_state_list"
                        android:drawablePadding="0dp"
                        android:paddingHorizontal="80dp"
                        android:text="Add To Favorites"
                        android:textOff=" Add To Favorites"
                        android:textOn=" Added to Favorites"
                        android:backgroundTint="@color/pinkRed"
                        android:layout_marginRight="5dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginBottom="5dp"
                        app:cardCornerRadius="8dp"
                        android:textSize="15dp"
                        android:fontFamily="@font/oswald"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/anime_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/oswald"
                        android:layout_marginTop="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="10dp"
                        android:textColor="#F6306B" />

                    <!-- Anime Genres -->

                    <TextView
                        android:id="@+id/anime_genres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:fontFamily="@font/oswald"
                        android:layout_marginRight="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginBottom="10dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="8dp"
                android:layout_margin="10dp"
                android:elevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Anime Description -->

                    <TextView
                        android:id="@+id/anime_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:fontFamily="@font/oswald"
                        android:textColor="#F6306B"
                        android:layout_margin="10dp" />

                    <!-- Anime Sub or Dub
                    <TextView
                        android:id="@+id/anime_sub_or_dub_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sub or Dub:"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/anime_sub_or_dub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:layout_marginTop="20dp"/>-->

                    <TextView
                        android:id="@+id/anime_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:fontFamily="@font/oswald"
                        android:layout_margin="10dp"
                        android:textColor="#F6306B" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_margin="10dp">

                        <TextView
                            android:id="@+id/anime_release_date_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Release Date:"
                            android:fontFamily="@font/oswald"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" /> <!-- Space between label and text -->

                        <TextView
                            android:id="@+id/anime_release_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:fontFamily="@font/oswald"
                            android:layout_marginEnd="20dp" /> <!-- Margin for spacing -->

                        <TextView
                            android:id="@+id/anime_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:fontFamily="@font/oswald" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Anime Other Name
            <TextView
                android:id="@+id/anime_other_name_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other Name:"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/anime_other_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp" />-->


        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EPISODES:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/oswald"
            android:layout_marginTop="20dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"/>


        <!-- Episode list container -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episode_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="true" />

        <!-- Loading animation -->
        <ProgressBar
            android:id="@+id/loadingAnimation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" /> <!-- Start hidden -->

    </LinearLayout>

</androidx.core.widget.NestedScrollView>